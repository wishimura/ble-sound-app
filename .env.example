# ---- Neon (PostgreSQL) ----
# Neon の接続文字列。Neon コンソール > Connection Details からコピー。
# 例: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Auth ----
# セッション JWT の署名鍵。十分に長いランダム文字列を設定してください。
# 生成例: openssl rand -base64 48
JWT_SECRET=

# ---- Vercel Blob（任意） ----
# 画像 / 音声を管理画面から直接アップロードするのに使います。
# Vercel ダッシュボード > Storage > Create Database > Blob で作成すると自動付与されます。
BLOB_READ_WRITE_TOKEN=

# ---- OpenAI TTS（任意） ----
# 「AIで音声を生成」ボタンで高品質ナレーション mp3 を生成するのに使います。
# 未設定の場合、ボタンを押すと未設定エラーを返します。
OPENAI_API_KEY=
# 任意。既定: tts-1（速い）。tts-1-hd にすると更に高品質。
OPENAI_TTS_MODEL=tts-1
# 任意。既定: nova。alloy / echo / fable / onyx / nova / shimmer から選択。
OPENAI_TTS_VOICE=nova

# ---- Seed (任意) ----
# scripts/seed.ts が作成する管理者アカウントの初期パスワード。
SEED_PASSWORD=password1234
